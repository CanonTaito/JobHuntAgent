{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "JobHunt": "Data Source=jobhunt.db"
  },
  "AI": {
    "Provider": "ollama",
    "Zen": {
      "Endpoint": "https://opencode.ai/zen/v1",
      "ChatModel": "big-pickle"
    },
    "Ollama": {
      "Endpoint": "http://localhost:11434/v1",
      "ChatModel": "gemma3",
      "EmbeddingModel": "nomic-embed-text"
    }
  },
  "Jobs": {
    "Source": "in-memory",
    "Seek": {
      "Endpoint": "https://www.seek.com.au/api/chalice-search/v4/search",
      "SiteKey": "AU-Main",
      "SourceSystem": "houston",
      "PageSize": 30,
      "MaxPages": 2,
      "MinRequestIntervalMs": 1000,
      "CacheMinutes": 30,
      "TimeoutSeconds": 15
    }
  }
}